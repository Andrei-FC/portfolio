---
import "../styles/base.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Lightbox from "../components/Lightbox.astro";
import { otherLocale, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  accent?: "handy-golf" | "cuefit" | "pace";
  inverseHeader?: boolean;
  path?: string;
}
const { locale, title, description = "", accent, inverseHeader = false, path = "" } = Astro.props;
const other = otherLocale(locale);
---
<!doctype html>
<html lang={locale === "pt" ? "pt-BR" : "en"} data-accent={accent}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="alternate" hreflang={locale} href={new URL(`/${locale}${path}`, Astro.site)} />
    <link rel="alternate" hreflang={other} href={new URL(`/${other}${path}`, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(`/en${path}`, Astro.site)} />
  </head>
  <body>
    <Header locale={locale} inverse={inverseHeader} />
    <main><slot /></main>
    <Footer locale={locale} />
    <Lightbox locale={locale} />
  </body>
</html>
