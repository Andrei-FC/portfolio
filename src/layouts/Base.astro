---
import "../styles/base.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Lightbox from "../components/Lightbox.astro";
import { localePath, otherLocale, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  accent?: "handy-golf" | "cuefit" | "pace";
  inverseHeader?: boolean;
  path?: string;
}
const { locale, title, description = "", accent, inverseHeader = false, path = "" } = Astro.props;
const other = otherLocale(locale);
---
<!doctype html>
<html lang={locale === "pt" ? "pt-BR" : "en"} data-accent={accent}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(localePath(locale, path), Astro.site)} />
    <link rel="alternate" hreflang={locale} href={new URL(localePath(locale, path), Astro.site)} />
    <link rel="alternate" hreflang={other} href={new URL(localePath(other, path), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(localePath("en", path), Astro.site)} />

    {/* Google Analytics. is:inline keeps Astro from bundling these — the snippet
        has to reach the page verbatim, in this order, for gtag to exist when the
        second script runs. Left out of `astro dev` so clicking around locally
        does not show up as traffic. */}
    {import.meta.env.PROD && (
      <>
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-GFJ7YGH8HH"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());

          gtag('config', 'G-GFJ7YGH8HH');
        </script>
      </>
    )}
  </head>
  <body>
    <Header locale={locale} inverse={inverseHeader} />
    <main><slot /></main>
    <Footer locale={locale} />
    <Lightbox locale={locale} />
  </body>
</html>
