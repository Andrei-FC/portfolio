---
/* Nav chevron, 8 x 4 drawn on a 9.25 x 5.25 box — the extra is the round cap
   overhanging the path, exactly as the file exports it. Stroke follows the
   label colour, which is the only thing that changes across the variants. */
---
<svg class="chevron" width="9.25" height="5.25" viewBox="0 0 9.25 5.25" fill="none" aria-hidden="true" focusable="false">
  <path
    d="M0.625 0.625L4.625 4.625L8.625 0.625"
    stroke="currentColor"
    stroke-width="1.25"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>

<style>
  .chevron { flex: none; }
</style>
