---
import { t, type Locale } from "../i18n/ui";
interface Props { locale: Locale; eyebrow?: string; columns: string[]; rows: string[][] }
const { locale, eyebrow, columns, rows } = Astro.props;
const tr = t(locale);
---
<div class="ctable">
  <div class="ctable__head">
    {eyebrow && <span class="t-label eyebrow">{eyebrow}</span>}
    <!-- Revealed by the script below, only on a table that actually overflows. -->
    <span class="t-label muted ctable__swipe">{tr("case.swipe")} →</span>
  </div>
  <div class="ctable__viewport">
    <table class="ctable__table">
      <thead>
        <tr>{columns.map((c) => <th scope="col" class="t-label muted">{c}</th>)}</tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>{row.map((cell, i) => <td class:list={["t-body-m", i === 0 && "muted"]}>{cell}</td>)}</tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<style>
  .ctable__head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-element); margin-bottom: var(--space-text); }
  .ctable__swipe { display: none; }
  /* The table owns its overflow so the page can never inherit it. A no-op at
     any width where the matrix fits. */
  .ctable__viewport { overflow-x: auto; overscroll-behavior-x: contain; }
  .ctable__table { width: 100%; border-collapse: collapse; text-align: left; }
  .ctable__table th, .ctable__table td {
    padding-block: var(--space-element);
    border-top: 1px solid var(--border-hairline);
    vertical-align: top;
    padding-right: var(--gutter);
    font-weight: inherit;
  }
  .ctable__table th:last-child, .ctable__table td:last-child { padding-right: 0; }

  @media (max-width: 760px) {
    /* Reading across a row is the point here, so the matrix keeps its shape
       and scrolls rather than wrapping each cell into a column of words. */
    .ctable__table { width: max-content; min-width: 100%; }
    .ctable__table th, .ctable__table td { white-space: nowrap; }
    /* Once it really is wider than the screen it bleeds to the right edge:
       cut text is what says there is more. */
    .ctable.is-overflowing { margin-right: calc(-1 * var(--page-margin)); }
    .ctable.is-overflowing .ctable__swipe { display: inline; margin-right: var(--page-margin); }
  }
</style>

<script>
  // Whether a table outgrows its box depends on the text, the font and the
  // viewport, so it is measured rather than declared per case.
  const tables = document.querySelectorAll<HTMLElement>(".ctable");
  if (tables.length) {
    const measure = () => {
      for (const table of tables) {
        const viewport = table.querySelector<HTMLElement>(".ctable__viewport");
        if (!viewport) continue;
        table.classList.toggle("is-overflowing", viewport.scrollWidth > viewport.clientWidth + 1);
      }
    };
    measure();
    addEventListener("resize", measure, { passive: true });
    document.fonts?.ready.then(measure);
  }
</script>
