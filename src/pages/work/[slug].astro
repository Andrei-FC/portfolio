---
import { getCollection } from "astro:content";
import CasePage from "../../components/pages/CasePage.astro";

export async function getStaticPaths() {
  const entries = await getCollection("cases", (e) => e.id.startsWith("en/"));
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
---
<CasePage locale="en" entry={entry} />
